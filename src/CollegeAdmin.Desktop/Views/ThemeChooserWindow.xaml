<Window x:Class="CollegeAdmin.Desktop.Views.ThemeChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Your Theme" Height="520" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="White">
    <!-- Bootstrap-only theme picker (first run, before any saved preference exists — see
         App.xaml.cs's RunStartupFlowAsync and ThemeService.HasSavedPreference). Every color/font
         here is a hardcoded literal, not a {StaticResource} — this window must be able to preview
         all three presets side by side without actually applying any of them, and it opens before
         the app-wide theme resources are necessarily the ones the user will end up choosing. -->
    <Grid Margin="40,32,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Welcome to College Admin" FontFamily="Segoe UI" FontSize="24"
                   FontWeight="Bold" Foreground="#1E1B2E"/>
        <TextBlock Grid.Row="1" Text="Pick a look for the app. You can change this later from Settings."
                   FontFamily="Segoe UI" FontSize="13" Foreground="#5B5A78" Margin="0,6,0,26"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">

            <RadioButton x:Name="IndigoOption" GroupName="ThemeChoice" Tag="indigo" Margin="0,0,20,0"
                         IsChecked="True" Checked="ThemeOption_Checked" Cursor="Hand">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Width="220" Height="300" CornerRadius="16" BorderThickness="2"
                                BorderBrush="#E5E7F5" Background="White">
                            <StackPanel>
                                <Border Height="100" CornerRadius="14,14,0,0" Background="#1E1B4B">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#6366F1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="18,16,18,0">
                                    <TextBlock Text="Indigo Night" FontFamily="Segoe UI" FontSize="15"
                                               FontWeight="SemiBold" Foreground="#1E1B2E"/>
                                    <TextBlock Text="Deep indigo &amp; violet — the original look."
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#5B5A78"
                                               TextWrapping="Wrap" Margin="0,4,0,16"/>
                                    <TextBlock Text="Aa College Admin" FontFamily="Segoe UI" FontSize="15"
                                               Foreground="#1E1B2E"/>
                                    <TextBlock Text="Segoe UI" FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#9694B5" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>

            <RadioButton x:Name="EmeraldOption" GroupName="ThemeChoice" Tag="emerald" Margin="0,0,20,0"
                         Checked="ThemeOption_Checked" Cursor="Hand">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Width="220" Height="300" CornerRadius="16" BorderThickness="2"
                                BorderBrush="#E5E7F5" Background="White">
                            <StackPanel>
                                <Border Height="100" CornerRadius="14,14,0,0" Background="#064E3B">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#059669"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="18,16,18,0">
                                    <TextBlock Text="Emerald Fresh" FontFamily="Segoe UI" FontSize="15"
                                               FontWeight="SemiBold" Foreground="#1E1B2E"/>
                                    <TextBlock Text="Calm emerald green, modern variable font."
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#5B5A78"
                                               TextWrapping="Wrap" Margin="0,4,0,16"/>
                                    <TextBlock Text="Aa College Admin" FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="15" Foreground="#1E1B2E"/>
                                    <TextBlock Text="Segoe UI Variable" FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#9694B5" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>

            <RadioButton x:Name="SlateOption" GroupName="ThemeChoice" Tag="slate"
                         Checked="ThemeOption_Checked" Cursor="Hand">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Width="220" Height="300" CornerRadius="16" BorderThickness="2"
                                BorderBrush="#E5E7F5" Background="White">
                            <StackPanel>
                                <Border Height="100" CornerRadius="14,14,0,0" Background="#0F172A">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#2563EB"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="18,16,18,0">
                                    <TextBlock Text="Slate Professional" FontFamily="Segoe UI" FontSize="15"
                                               FontWeight="SemiBold" Foreground="#1E1B2E"/>
                                    <TextBlock Text="Cool slate blue, crisp Trebuchet font."
                                               FontFamily="Segoe UI" FontSize="11" Foreground="#5B5A78"
                                               TextWrapping="Wrap" Margin="0,4,0,16"/>
                                    <TextBlock Text="Aa College Admin" FontFamily="Trebuchet MS, Segoe UI"
                                               FontSize="15" Foreground="#1E1B2E"/>
                                    <TextBlock Text="Trebuchet MS" FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#9694B5" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>
        </StackPanel>

        <!-- Uses the app's real PrimaryButton style/template (Theme/Controls.xaml) rather than
             hardcoded chrome — unlike the preview cards above, this button's own look doesn't need
             to stay independent of whichever theme is currently merged in App.Resources, and
             reusing it means it gets the same animated hover/press feedback as every other button
             in the app for free. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource PrimaryButton}"
                    FontSize="14" Padding="28,11" Cursor="Hand" Click="ContinueButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
