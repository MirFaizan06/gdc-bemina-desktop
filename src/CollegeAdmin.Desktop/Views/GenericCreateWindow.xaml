<Window x:Class="CollegeAdmin.Desktop.Views.GenericCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="560" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource PageBgBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding DisplayLabel}" Style="{StaticResource LabelText}"/>
                            <!-- Final Convergence Phase P0-4: a field with Options (e.g. a real
                                 Programme picker) renders as a ComboBox instead of a free-text box;
                                 every other field is completely unaffected. -->
                            <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap"
                                     MinHeight="34" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                     Visibility="{Binding IsPlainText, Converter={StaticResource BoolToVisibility}}"/>
                            <!-- Final Convergence Phase P0-7: a field with UploadModule set renders a
                                 real file-picker (Browse button + read-only current-selection text)
                                 instead of a free-text path box — Value still ends up holding the
                                 server-assigned path, so the submit pipeline needs no changes. -->
                            <!-- Final Convergence Phase P1-13: a plain boolean flag renders as a
                                 real CheckBox — Value stays the "1"/"0" string the server already
                                 expects, via the CheckedValue two-way bridge. -->
                            <CheckBox IsChecked="{Binding CheckedValue}"
                                      Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisibility}}"/>
                            <Grid Visibility="{Binding IsFileUpload, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"
                                         Text="{Binding DisplayFileName, Mode=OneWay}"/>
                                <Button Grid.Column="1" Content="Browse..." Padding="10,6"
                                        Click="BrowseButton_Click" Tag="{Binding}"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                    Padding="18,7" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
