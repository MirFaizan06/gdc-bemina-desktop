<UserControl x:Class="CollegeAdmin.Desktop.Views.SubmissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!-- Final Convergence Phase P1-10/§2b: admin handling for Contact/Grievance/Alumni. Public
         submission forms stay on the legacy website. Committee-scoped visibility (the IDOR fix) is
         entirely server-enforced — this screen just renders whatever the server allows. -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

        <TabControl>
            <TabItem Header="Contact">
                <ItemsControl ItemsSource="{Binding Contact}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Reply" FontSize="11" Padding="8,4" Margin="0,0,4,0" Click="ReplyContactButton_Click" Tag="{Binding}"/>
                                        <Button Content="Forward" FontSize="11" Padding="8,4" Margin="0,0,4,0" Click="ForwardContactButton_Click" Tag="{Binding}"/>
                                        <Button Content="Delete" FontSize="11" Padding="8,4" Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.DeleteContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Email, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Subject}" Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource CaptionText}" Foreground="#059669"
                                                   Visibility="{Binding ReplyBody, Converter={StaticResource NullOrEmptyToCollapsed}}">
                                            <Run Text="Replied: "/>
                                            <Run Text="{Binding ReplyBody, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>

            <TabItem Header="Grievances">
                <ItemsControl ItemsSource="{Binding Grievances}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Reply" FontSize="11" Padding="8,4" Margin="0,0,4,0" Click="ReplyGrievanceButton_Click" Tag="{Binding}"/>
                                        <Button Content="Forward" FontSize="11" Padding="8,4" Margin="0,0,4,0" Click="ForwardGrievanceButton_Click" Tag="{Binding}"/>
                                        <Button Content="Advance Status" FontSize="11" Padding="8,4"
                                                Command="{Binding DataContext.AdvanceGrievanceStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Category, Mode=OneWay}"/>
                                            <Run Text=" ["/>
                                            <Run Text="{Binding Status, Mode=OneWay}"/>
                                            <Run Text="]"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource CaptionText}" Foreground="#059669"
                                                   Visibility="{Binding ReplyBody, Converter={StaticResource NullOrEmptyToCollapsed}}">
                                            <Run Text="Replied: "/>
                                            <Run Text="{Binding ReplyBody, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>

            <TabItem Header="Alumni">
                <ItemsControl ItemsSource="{Binding Alumni}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button FontSize="11" Padding="8,4" Margin="0,0,4,0"
                                                Command="{Binding DataContext.ToggleAlumnusShowcaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Add to Showcase"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Showcase}" Value="True">
                                                            <Setter Property="Content" Value="Remove from Showcase"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Delete" FontSize="11" Padding="8,4" Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.DeleteAlumnusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — Batch "/>
                                            <Run Text="{Binding BatchYear, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CurrentOccupation}" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
