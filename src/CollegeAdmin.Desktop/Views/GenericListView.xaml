<UserControl x:Class="CollegeAdmin.Desktop.Views.GenericListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:CollegeAdmin.Desktop.Views.Shared"
             mc:Ignorable="d">
    <Grid>
        <shared:LoadingView Message="Loading..."
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        <shared:ErrorStateView Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>
        <shared:EmptyStateView Title="{Binding Title, StringFormat='No {0} yet'}" Description="{Binding EmptyDescription}"
                                ActionLabel="{Binding AddLabel}" ActionCommand="{Binding AddCommand}"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        <DockPanel Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="False">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" DockPanel.Dock="Left"/>
                <Button Content="{Binding AddLabel}" Command="{Binding AddCommand}" DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="{Binding ImportLabel}" Command="{Binding ImportCommand}" DockPanel.Dock="Right" Margin="0,0,8,0"
                        Visibility="{Binding CanImport, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="Export CSV" Click="ExportButton_Click" DockPanel.Dock="Right" Margin="0,0,8,0"
                        Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="{Binding DeleteButtonLabel, StringFormat='{}{0} Selected'}" Click="DeleteSelectedButton_Click" DockPanel.Dock="Right" Margin="0,0,8,0"
                        Style="{StaticResource DangerButton}"
                        Visibility="{Binding CanBulkDelete, Converter={StaticResource BoolToVisibility}}"/>
                <!-- Final Convergence Phase P1-18: client-side filter over the already-fully-loaded
                     Items (see GenericListViewModel's own remarks) — no network round-trip per
                     keystroke, so no debounce is needed the way a server-side search would require. -->
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="200" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         AutomationProperties.AutomationId="SearchBox"/>
                <TextBlock Text="Search:" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}"/>
                <!-- Final Convergence Phase P2 item 1: only Departments/Faculty/Committees/Subjects/
                     Programmes are archivable — every other module hides this entirely. -->
                <CheckBox Content="Show Archived" IsChecked="{Binding ShowArchived}" DockPanel.Dock="Right" Margin="0,0,16,0"
                          VerticalAlignment="Center" Visibility="{Binding IsArchivable, Converter={StaticResource BoolToVisibility}}"/>
            </DockPanel>
            <!-- Pagination footer -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
                <TextBlock Text="{Binding PageLabel}" Style="{StaticResource CaptionText}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" DockPanel.Dock="Right" Padding="12,5"/>
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,5"/>
            </DockPanel>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="0">
                <!-- AutoGenerateColumns still generates one column per row-object property; this
                     explicit "Actions" column is added first in markup so WPF appends the
                     auto-generated data columns after it (DisplayIndex order follows declaration
                     order), giving Edit/Delete a fixed leftmost column across every module. -->
                <DataGrid x:Name="Grid" ItemsSource="{Binding PagedItems}" AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" BorderThickness="0"
                          SelectionMode="Extended" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="150" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                        <Button Content="{Binding DataContext.ManageLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                FontSize="11" Padding="8,3" Margin="0,0,4,0"
                                                Command="{Binding DataContext.ManageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Edit" FontSize="11" Padding="8,3" Margin="0,0,4,0"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="{Binding DataContext.DeleteButtonLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                FontSize="11" Padding="8,3" Click="DeleteButton_Click"
                                                Style="{StaticResource DangerButton}"
                                                Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Restore" FontSize="11" Padding="8,3" Margin="4,0,0,0"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanRestore, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
