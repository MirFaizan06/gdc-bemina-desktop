<Window x:Class="CollegeAdmin.Desktop.Views.TimetableEntryCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="680" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource PageBgBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Academic Year / Programme ID -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Academic Year (e.g. 2026-27)" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding AcademicYear, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Programme" Style="{StaticResource LabelText}"/>
                <ComboBox ItemsSource="{Binding ProgrammeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding ProgrammeId, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <!-- Row 2: Semester / Section -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Semester" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding Semester, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Section (optional)" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Subject" Style="{StaticResource LabelText}"/>
            <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Row 6: Faculty ID / Room -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Faculty ID (optional)" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding FacultyId, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Room (optional)" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding Room, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <!-- Row 8: Day / Start / End -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Day" Style="{StaticResource LabelText}"/>
                <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Start (HH:MM)" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="End (HH:MM)" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <!-- Row 10: Scope -->
        <StackPanel Grid.Row="10">
            <TextBlock Text="Scope" Style="{StaticResource LabelText}"/>
            <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}"/>
        </StackPanel>

        <!-- Row 12: Department ID / Committee ID (whichever scope is selected) -->
        <StackPanel Grid.Row="12" Visibility="{Binding IsDepartmentScope, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Department ID" Style="{StaticResource LabelText}"/>
            <TextBox Text="{Binding DepartmentId, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Row="12" Visibility="{Binding IsCommitteeScope, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Committee ID" Style="{StaticResource LabelText}"/>
            <TextBox Text="{Binding CommitteeId, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <TextBlock Grid.Row="14" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

        <StackPanel Grid.Row="16" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="CancelButton_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="18,7" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
