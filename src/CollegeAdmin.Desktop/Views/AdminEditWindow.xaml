<Window x:Class="CollegeAdmin.Desktop.Views.AdminEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit Admin" Height="420" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource PageBgBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Edit Admin" Style="{StaticResource SectionTitleText}"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Email" Style="{StaticResource LabelText}"/>
            <TextBlock Text="{Binding Email}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Name" Style="{StaticResource LabelText}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Role" Style="{StaticResource LabelText}"/>
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"/>
        </StackPanel>

        <CheckBox Grid.Row="8" Content="Active" IsChecked="{Binding IsActive}" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="9" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" VerticalAlignment="Top" Margin="0,10,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="CancelButton_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="18,7" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
