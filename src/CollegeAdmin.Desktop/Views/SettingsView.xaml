<UserControl x:Class="CollegeAdmin.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:CollegeAdmin.Desktop.Views.Shared"
             mc:Ignorable="d">
    <!-- Final Convergence Phase P1-15: "System" renamed to "Settings" — Credits (CLAUDE.md's own
         developer-credit requirement) is now one section of this screen, alongside connectivity
         status (a live ping, not a cached assumption), the running app version, and basic
         diagnostics (API base URL, last successful request time). -->
    <Grid>
        <shared:LoadingView Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        <shared:ErrorStateView Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

        <ScrollViewer Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Margin="4" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="Settings" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16"/>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CONNECTIVITY" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Status: " Style="{StaticResource BodyText}"/>
                            <TextBlock Text="Connected" Foreground="Green" FontWeight="SemiBold"
                                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="Not Connected" Foreground="Red" FontWeight="SemiBold"
                                       Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,4"
                                   Visibility="{Binding LastSuccessfulCheckAt, Converter={StaticResource NotNullToVisibility}}">
                            <Run Text="Last successful check: "/>
                            <Run Text="{Binding LastSuccessfulCheckAt}"/>
                        </TextBlock>
                        <Button Content="Check Connectivity Now" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding CheckConnectivityCommand}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4">
                            <Run Text="App version: "/>
                            <Run Text="{Binding AppVersion}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap">
                            <Run Text="API base URL: "/>
                            <Run Text="{Binding ApiBaseUrl}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="24">
                    <StackPanel>
                        <TextBlock Text="CREDITS" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                        <TextBlock Text="DEVELOPED BY" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Company}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Developer}" Style="{StaticResource BodyText}" Margin="0,2,0,0"/>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,16"/>

                        <TextBlock Text="CONTACT" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding BusinessEmail}" Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
