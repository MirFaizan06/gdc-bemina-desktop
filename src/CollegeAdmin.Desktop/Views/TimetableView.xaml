<UserControl x:Class="CollegeAdmin.Desktop.Views.TimetableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:CollegeAdmin.Desktop.Views.Shared"
             xmlns:views="clr-namespace:CollegeAdmin.Desktop.Views"
             xmlns:contracts="clr-namespace:CollegeAdmin.Contracts.Api;assembly=CollegeAdmin.Contracts"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- One entry "card", shared by all six day columns below instead of repeating the same
             markup per day. Clicking it opens Edit (List.EditCommand — the same command the flat-
             list mode already uses); Delete confirms via this View's own code-behind, mirroring
             GenericListView's confirmation pattern for the same testability reason. -->
        <DataTemplate x:Key="EntryCardTemplate" DataType="{x:Type contracts:TimetableEntryDto}">
            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Padding="6,4" Margin="0,0,0,2"
                    Cursor="Hand" MouseLeftButtonUp="EntryCard_Click">
                <StackPanel>
                    <TextBlock Text="{Binding Subject}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Room}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding Room, Converter={StaticResource NullOrEmptyToCollapsed}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DayColumnTemplate">
            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource EntryCardTemplate}" Margin="2"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <shared:LoadingView Message="Loading timetable..."
                             Visibility="{Binding List.IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        <shared:ErrorStateView Message="{Binding List.ErrorMessage}" RetryCommand="{Binding List.LoadCommand}"
                                Visibility="{Binding List.ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

        <DockPanel Visibility="{Binding List.IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="False">
                <TextBlock Text="Timetable" Style="{StaticResource PageTitleText}" DockPanel.Dock="Left"/>
                <Button Content="{Binding List.AddLabel}" Command="{Binding List.AddCommand}" DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding List.CanAdd, Converter={StaticResource BoolToVisibility}}"/>
                <Button DockPanel.Dock="Right" Margin="0,0,8,0" Click="ExportButton_Click"
                        Content="Export CSV"
                        Visibility="{Binding List.CanExport, Converter={StaticResource BoolToVisibility}}"/>
                <Button DockPanel.Dock="Right" Margin="0,0,8,0" Command="{Binding ToggleViewCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="View as List"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                    <Setter Property="Content" Value="View as Grid"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>

            <!-- Grid-mode filters: narrows the visual grid to one programme/semester so a real
                 weekly timetable is legible (unfiltered, unrelated classes sharing a day+time slot
                 would land in the same cell). Filters client-side over already-loaded rows, not a
                 new server round-trip — this app's per-college data volume doesn't need one. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False"
                       Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Programme:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource CaptionText}"/>
                    <ComboBox Width="180" ItemsSource="{Binding ProgrammeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding FilterProgrammeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>
                    <TextBlock Text="Semester:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource CaptionText}"/>
                    <TextBox Width="60" Text="{Binding FilterSemester, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </DockPanel>

            <!-- Grid mode -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="0"
                    Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}">
                <DataGrid ItemsSource="{Binding GridRows}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" BorderThickness="0"
                          RowHeight="76" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimeLabel}" Width="70"/>
                        <DataGridTemplateColumn Header="Mon" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Mon}" ContentTemplate="{StaticResource DayColumnTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Tue" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Tue}" ContentTemplate="{StaticResource DayColumnTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Wed" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Wed}" ContentTemplate="{StaticResource DayColumnTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Thu" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Thu}" ContentTemplate="{StaticResource DayColumnTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Fri" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Fri}" ContentTemplate="{StaticResource DayColumnTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Sat" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Sat}" ContentTemplate="{StaticResource DayColumnTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- List mode: the existing, fully-working GenericListView, just re-hosted here with
                 its DataContext pointed at the wrapped GenericListViewModel — Add/Edit/Delete/
                 Export all keep working completely unchanged. -->
            <views:GenericListView DataContext="{Binding List}"
                                    Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVisibility}}"/>
        </DockPanel>
    </Grid>
</UserControl>
