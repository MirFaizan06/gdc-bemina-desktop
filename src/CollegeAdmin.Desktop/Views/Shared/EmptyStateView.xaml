<UserControl x:Class="CollegeAdmin.Desktop.Views.Shared.EmptyStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" x:Name="Root">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="28" Width="56" Height="56"
                HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="—" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding Title, ElementName=Root, FallbackValue=Nothing here yet}"
                   Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding Description, ElementName=Root}" TextWrapping="Wrap"
                   Style="{StaticResource CaptionText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,18"/>
        <Button Content="{Binding ActionLabel, ElementName=Root}" Command="{Binding ActionCommand, ElementName=Root}"
                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                Visibility="{Binding ActionLabel, ElementName=Root, Converter={StaticResource NullOrEmptyToCollapsed}}"/>
    </StackPanel>
</UserControl>
