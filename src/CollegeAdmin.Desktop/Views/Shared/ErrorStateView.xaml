<UserControl x:Class="CollegeAdmin.Desktop.Views.Shared.ErrorStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" x:Name="Root">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
        <Border Background="{StaticResource DangerBgBrush}" CornerRadius="28" Width="56" Height="56"
                HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding Message, ElementName=Root, FallbackValue=Something went wrong.}"
                   Style="{StaticResource BodyText}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>
        <Button Content="Retry" Command="{Binding RetryCommand, ElementName=Root}"
                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
