<UserControl x:Class="CollegeAdmin.Desktop.Views.PyqsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:CollegeAdmin.Desktop.Views.Shared"
             mc:Ignorable="d">
    <!-- Final Convergence Phase P1-10/§2b: moderation + staff upload. Public submission and the
         IP-ban/NSFW-filter path stay on the legacy website, untouched. -->
    <Grid>
        <shared:LoadingView Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        <shared:ErrorStateView Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

        <ScrollViewer Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Margin="4">
                <TextBlock Text="Previous Year Questions" Style="{StaticResource SectionTitleText}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Pending" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding Counts.Pending}" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Approved" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding Counts.Approved}" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Rejected" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding Counts.Rejected}" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <TextBlock Text="Status (pending/approved/rejected/all)" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding StatusFilter, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="180"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <TextBlock Text="Search" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="200"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Papers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Approve" FontSize="11" Padding="8,4" Margin="0,0,4,0"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Status, Converter={StaticResource EqualsToVisibility}, ConverterParameter=pending}"/>
                                        <Button Content="Reject" FontSize="11" Padding="8,4" Margin="0,0,4,0"
                                                Style="{StaticResource DangerButton}" Click="RejectButton_Click" Tag="{Binding}"
                                                Visibility="{Binding Status, Converter={StaticResource EqualsToVisibility}, ConverterParameter=pending}"/>
                                        <Button Content="Recall" FontSize="11" Padding="8,4" Margin="0,0,4,0"
                                                Command="{Binding DataContext.RecallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Status, Converter={StaticResource EqualsToVisibility}, ConverterParameter=rejected}"/>
                                        <Button Content="Delete" FontSize="11" Padding="8,4"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Subject, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionText}">
                                            <Run Text="Sem "/>
                                            <Run Text="{Binding Semester, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Type, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Year, Mode=OneWay}"/>
                                            <Run Text=" · Status: "/>
                                            <Run Text="{Binding Status, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Visibility="{Binding ContributorName, Converter={StaticResource NullOrEmptyToCollapsed}}">
                                            <Run Text="Contributor: "/>
                                            <Run Text="{Binding ContributorName, Mode=OneWay}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding ContributorRoll, Mode=OneWay}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RejectionReason}" Style="{StaticResource CaptionText}" Foreground="#B91C1C"
                                                   Visibility="{Binding RejectionReason, Converter={StaticResource NullOrEmptyToCollapsed}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Add Paper (staff upload — added pre-approved)" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Title"/>
                        <TextBox Text="{Binding NewSubject, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Subject"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewSemester, UpdateSourceTrigger=PropertyChanged}" ToolTip="Semester (1-8)"/>
                            <TextBox Grid.Column="2" Text="{Binding NewType, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type (external/internal/assessment/practical/other)"/>
                            <TextBox Grid.Column="4" Text="{Binding NewYear, UpdateSourceTrigger=PropertyChanged}" ToolTip="Year"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0" Text="{Binding DisplayNewFileName, Mode=OneWay}"/>
                            <Button Grid.Column="1" Content="Browse..." Padding="10,6" Click="BrowseButton_Click"/>
                        </Grid>
                        <Button Content="Add Paper" Command="{Binding AddPaperCommand}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Padding="14,6"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
