<Window x:Class="CollegeAdmin.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="College Admin — Sign In" Height="520" Width="440"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" ResizeMode="CanResize"
        Background="White">
    <Grid>
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Width="440"
                Padding="36,40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="24" ShadowDepth="6"/>
            </Border.Effect>
            <StackPanel>
                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10" Width="48" Height="48"
                        HorizontalAlignment="Left">
                    <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="College Admin" Style="{StaticResource PageTitleText}" Margin="0,20,0,4"/>
                <TextBlock Text="Sign in to manage your college's website and records." Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,0,0,28"/>

                <TextBlock Text="Email" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="EmailBox" AutomationProperties.AutomationId="EmailBox"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password" Style="{StaticResource LabelText}" Margin="0,18,0,4"/>
                <PasswordBox x:Name="PasswordBox" AutomationProperties.AutomationId="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                           Margin="0,14,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

                <!-- No busy-label converter: the button's enabled state already tracks IsBusy via
                     LoginCommand's CanExecute (WPF wires ICommand.CanExecute to Button.IsEnabled
                     automatically) — a spinner/label swap is Stage 4/5 UI-polish territory, not needed
                     to prove the login flow itself works. -->
                <Button Content="Sign In" Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButton}"
                        AutomationProperties.AutomationId="SignInButton"
                        Height="40" HorizontalAlignment="Stretch" IsDefault="True" Margin="0,24,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
