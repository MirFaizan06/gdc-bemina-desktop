<UserControl x:Class="CollegeAdmin.Desktop.Views.CertificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:CollegeAdmin.Desktop.Views.Shared"
             mc:Ignorable="d">
    <!-- Final Convergence Phase P1-10/§2b: admin review only — student-facing application/upload/
         download/QR-verification pages stay web-based per the tracker's own "Preserve" note. -->
    <Grid>
        <shared:LoadingView Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        <shared:ErrorStateView Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

        <ScrollViewer Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Margin="4">
                <TextBlock Text="Certifications" Style="{StaticResource SectionTitleText}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Pending" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding Stats.Pending}" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Approved" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding Stats.Approved}" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Rejected" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding Stats.Rejected}" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <TextBlock Text="Status filter (pending/approved/rejected/blank=all)" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding StatusFilter, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="220"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Applications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Approve" FontSize="11" Padding="10,5" Margin="0,0,6,0"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Status, Converter={StaticResource EqualsToVisibility}, ConverterParameter=pending}"/>
                                        <Button Content="Reject" FontSize="11" Padding="10,5"
                                                Style="{StaticResource DangerButton}" Click="RejectButton_Click" Tag="{Binding}"
                                                Visibility="{Binding Status, Converter={StaticResource EqualsToVisibility}, ConverterParameter=pending}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run Text="{Binding StudentName, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding TypeName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Purpose}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource CaptionText}">
                                            <Run Text="Status: "/>
                                            <Run Text="{Binding Status, Mode=OneWay}"/>
                                            <Run Text=" · Cert#: "/>
                                            <Run Text="{Binding CertificateNumber, Mode=OneWay, TargetNullValue='—'}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RejectionReason}" Style="{StaticResource CaptionText}" Foreground="#B91C1C"
                                                   Visibility="{Binding RejectionReason, Converter={StaticResource NullOrEmptyToCollapsed}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Certificate Types" Style="{StaticResource SectionTitleText}" FontSize="16" Margin="0,20,0,8"/>
                <ItemsControl ItemsSource="{Binding Types}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Toggle Active"
                                            FontSize="11" Padding="8,3"
                                            Command="{Binding DataContext.ToggleTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding Code, Mode=OneWay}"/>
                                        <Run Text=") — prefix "/>
                                        <Run Text="{Binding Prefix, Mode=OneWay}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding IsActive, Mode=OneWay, StringFormat='{}{0}'}"/>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Add Certificate Type (off by default until a template exists)" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewTypeCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="Code (e.g. transfer_certificate)"/>
                            <TextBox Grid.Column="2" Text="{Binding NewTypeName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name (e.g. Transfer Certificate)"/>
                            <TextBox Grid.Column="4" Width="80" Text="{Binding NewTypePrefix, UpdateSourceTrigger=PropertyChanged}" ToolTip="Prefix (e.g. TC)"/>
                            <Button Grid.Column="6" Content="Add" Command="{Binding AddTypeCommand}" Padding="14,6"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
