<Window x:Class="CollegeAdmin.Desktop.Views.StudentImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Import Students from Excel" Height="720" Width="980"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PageBgBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Import Students from Excel" Style="{StaticResource SectionTitleText}"/>
            <Button Grid.Column="1" Content="Choose File..." Click="ChooseFileButton_Click" Padding="14,7"
                    Style="{StaticResource PrimaryButton}"/>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding HeaderIssues}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFF6E5" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="4"
                            Padding="10,6" Margin="0,0,0,6">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Visibility="{Binding HasBatch, Converter={StaticResource BoolToVisibility}}"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Batch.OriginalFilename}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                <TextBlock Margin="0,0,16,0"><Run Text="Status: "/><Run Text="{Binding Batch.Status}"/></TextBlock>
                <TextBlock Margin="0,0,16,0"><Run Text="Total: "/><Run Text="{Binding Batch.TotalRows}"/></TextBlock>
                <TextBlock Margin="0,0,16,0" Foreground="{StaticResource SuccessBrush}"><Run Text="Valid: "/><Run Text="{Binding Batch.ValidRows}"/></TextBlock>
                <TextBlock Margin="0,0,16,0" Foreground="{StaticResource WarningBrush}"><Run Text="Warning: "/><Run Text="{Binding Batch.WarningRows}"/></TextBlock>
                <TextBlock Margin="0,0,16,0" Foreground="{StaticResource DangerBrush}"><Run Text="Error: "/><Run Text="{Binding Batch.ErrorRows}"/></TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Row" Binding="{Binding RowNo}" Width="50"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                    <DataGridTextColumn Header="Application No" Binding="{Binding BoardRegNo}" Width="130"/>
                    <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="80"/>
                    <DataGridTextColumn Header="Issues" Binding="{Binding Issues}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="2" Visibility="{Binding SelectedRow, Converter={StaticResource NullOrEmptyToCollapsed}}">
                <TextBlock Text="Edit Row" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Full Name" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding SelectedRow.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Application No" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding SelectedRow.BoardRegNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Course" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding SelectedRow.TypeOfCourse, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Semester" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding SelectedRow.Semester, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Resolution" Style="{StaticResource LabelText}"/>
                <ComboBox SelectedValue="{Binding SelectedRow.Resolution}" SelectedValuePath="Content" Margin="0,0,0,10">
                    <ComboBoxItem Content="pending"/>
                    <ComboBoxItem Content="include"/>
                    <ComboBoxItem Content="exclude"/>
                </ComboBox>

                <TextBlock Text="{Binding SelectedRow.Issues}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,10"/>

                <Button Content="Save &amp; Revalidate" Command="{Binding SaveRowEditCommand}"
                        CommandParameter="{Binding SelectedRow}" Padding="14,7"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>
        <TextBlock Grid.Row="4" Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"
                   Visibility="{Binding ResultMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Click="CloseButton_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="Confirm Import" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}"
                    Padding="18,7" Visibility="{Binding HasBatch, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </Grid>
</Window>
