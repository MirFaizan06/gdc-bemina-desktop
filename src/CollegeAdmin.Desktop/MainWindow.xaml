<Window x:Class="CollegeAdmin.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CollegeAdmin.Desktop.ViewModels"
        xmlns:views="clr-namespace:CollegeAdmin.Desktop.Views"
        mc:Ignorable="d"
        Title="College Admin" Height="700" Width="1100" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <views:PlaceholderPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminsListViewModel}">
            <views:AdminsListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackgroundJobsViewModel}">
            <views:BackgroundJobsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimetableViewModel}">
            <views:TimetableView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
            <views:AuditLogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrincipalOverviewViewModel}">
            <views:PrincipalOverviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcademicCalendarViewModel}">
            <views:AcademicCalendarView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrincipalSectionViewModel}">
            <views:PrincipalSectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CertificationsViewModel}">
            <views:CertificationsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubmissionsViewModel}">
            <views:SubmissionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BlogsViewModel}">
            <views:BlogsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PyqsViewModel}">
            <views:PyqsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GenericListViewModel}">
            <views:GenericListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TabbedListViewModel}">
            <views:TabbedListView/>
        </DataTemplate>
    </Window.Resources>

    <Window.Background>
        <SolidColorBrush Color="{StaticResource PageBgColor}"/>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource SidebarBgBrush}" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="20,0,0,0" VerticalAlignment="Center">
                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6" Width="28" Height="28">
                    <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="College Admin" Foreground="White" FontWeight="SemiBold" FontSize="15"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <Button Content="Sign Out" Command="{Binding LogoutCommand}"
                    Style="{StaticResource TextLinkButton}"
                    AutomationProperties.AutomationId="SignOutButton"
                    DockPanel.Dock="Right" Margin="0,0,20,0" Padding="10,6"
                    Foreground="{StaticResource SidebarTextBrush}"/>
            <TextBlock Text="{Binding WelcomeMessage}" Foreground="{StaticResource SidebarTextMutedBrush}"
                       VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,20,0" FontSize="12"/>
            <!-- Final Convergence Phase P1-16: reflects IConnectivityService's real traffic-derived
                 state — not a separate poll of its own. -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ConnectivityIndicator">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#22C55E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                    <Setter Property="Fill" Value="#EF4444"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectivityLabel}" Foreground="{StaticResource SidebarTextMutedBrush}" FontSize="12"/>
            </StackPanel>
        </DockPanel>

        <!-- Sidebar -->
        <ListBox Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderThickness="0"
                  ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}"
                  Padding="10,16,10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="14,11"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Content -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PageBgBrush}">
            <DockPanel>
                <!-- Update banner: hidden by default, shown when ShellViewModel's startup version
                     check finds a newer release. Dismiss just hides it for this session — it
                     reappears next launch, deliberately (it never silently stops being offered). -->
                <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="0,0,0,1"
                        Padding="20,12" Margin="0,0,0,0"
                        Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding UpdateBannerMessage}" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>
                            <Button Content="Dismiss" Command="{Binding DismissUpdateBannerCommand}"
                                    Style="{StaticResource TextLinkButton}" Padding="10,4" DockPanel.Dock="Right"/>
                            <Button Content="Download &amp; Install" Command="{Binding DownloadUpdateCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0"
                                    DockPanel.Dock="Right"/>
                            <!-- Final Convergence Phase P2 item 10: release notes existed on
                                 UpdateCheckResult since Stage 17 but were never shown anywhere. -->
                            <Button Content="What's New" Command="{Binding ToggleReleaseNotesCommand}"
                                    Style="{StaticResource TextLinkButton}" Padding="10,4" Margin="0,0,8,0" DockPanel.Dock="Right"
                                    Visibility="{Binding UpdateReleaseNotes, Converter={StaticResource NullOrEmptyToCollapsed}}"/>
                        </DockPanel>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0" MaxWidth="700" HorizontalAlignment="Left"
                                Visibility="{Binding IsReleaseNotesExpanded, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding UpdateReleaseNotes}" TextWrapping="Wrap" Style="{StaticResource BodyText}"/>
                        </Border>
                        <TextBlock Text="{Binding UpdateErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                   Visibility="{Binding UpdateErrorMessage, Converter={StaticResource NullOrEmptyToCollapsed}}"/>
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding CurrentPage}" Margin="24"/>
            </DockPanel>
        </Border>

        <!-- Final Convergence Phase P1-16: toast overlay, anchored bottom-right over the whole shell.
             ShellViewModel.Toasts owns auto-dismiss timing (4s); the × button dismisses immediately. -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                      ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,20,20" IsHitTestVisible="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="6" Padding="14,10" Margin="0,6,0,0" MaxWidth="340">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Success">
                                        <Setter Property="Background" Value="#16A34A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter Property="Background" Value="#D97706"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="Background" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="True">
                            <Button Content="×" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="4,0"
                                    Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
