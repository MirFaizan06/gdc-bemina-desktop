<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- College Admin design system v2 — one palette, used everywhere. A vivid indigo/violet
         primary tied into a deep indigo-navy sidebar (not flat slate-gray), plus four accent
         colors (teal/amber/rose/sky) for stat cards and category chips so the app doesn't read as
         a single monochrome gray box. -->

    <Color x:Key="PrimaryColor">#6366F1</Color>
    <Color x:Key="PrimaryDarkColor">#4338CA</Color>
    <Color x:Key="PrimaryLightColor">#EEF2FF</Color>

    <!-- Deep indigo-navy, not flat slate — ties the sidebar visually to PrimaryColor. -->
    <Color x:Key="SidebarBgColor">#1E1B4B</Color>
    <Color x:Key="SidebarHoverColor">#312E81</Color>
    <Color x:Key="SidebarSelectedColor">#4F46E5</Color>
    <Color x:Key="SidebarTextColor">#E0E7FF</Color>
    <Color x:Key="SidebarTextMutedColor">#A5B4FC</Color>

    <Color x:Key="PageBgColor">#F5F6FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E5E7F5</Color>
    <Color x:Key="BorderStrongColor">#C7CBE8</Color>

    <Color x:Key="TextPrimaryColor">#1E1B2E</Color>
    <Color x:Key="TextSecondaryColor">#5B5A78</Color>
    <Color x:Key="TextMutedColor">#9694B5</Color>

    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessBgColor">#F0FDF4</Color>
    <Color x:Key="DangerColor">#E11D48</Color>
    <Color x:Key="DangerDarkColor">#BE123C</Color>
    <Color x:Key="DangerBgColor">#FFF1F2</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningBgColor">#FFFBEB</Color>

    <!-- Accent colors — used for stat cards / category chips / badges so the app has real color
         variety instead of every card looking the same. -->
    <Color x:Key="AccentTealColor">#0D9488</Color>
    <Color x:Key="AccentTealBgColor">#F0FDFA</Color>
    <Color x:Key="AccentAmberColor">#D97706</Color>
    <Color x:Key="AccentAmberBgColor">#FFFBEB</Color>
    <Color x:Key="AccentRoseColor">#E11D48</Color>
    <Color x:Key="AccentRoseBgColor">#FFF1F2</Color>
    <Color x:Key="AccentSkyColor">#0284C7</Color>
    <Color x:Key="AccentSkyBgColor">#F0F9FF</Color>
    <Color x:Key="AccentVioletColor">#7C3AED</Color>
    <Color x:Key="AccentVioletBgColor">#F5F3FF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>

    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="{StaticResource SidebarTextMutedColor}"/>

    <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource PageBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDarkColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>

    <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTealColor}"/>
    <SolidColorBrush x:Key="AccentTealBgBrush" Color="{StaticResource AccentTealBgColor}"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}"/>
    <SolidColorBrush x:Key="AccentAmberBgBrush" Color="{StaticResource AccentAmberBgColor}"/>
    <SolidColorBrush x:Key="AccentRoseBrush" Color="{StaticResource AccentRoseColor}"/>
    <SolidColorBrush x:Key="AccentRoseBgBrush" Color="{StaticResource AccentRoseBgColor}"/>
    <SolidColorBrush x:Key="AccentSkyBrush" Color="{StaticResource AccentSkyColor}"/>
    <SolidColorBrush x:Key="AccentSkyBgBrush" Color="{StaticResource AccentSkyBgColor}"/>
    <SolidColorBrush x:Key="AccentVioletBrush" Color="{StaticResource AccentVioletColor}"/>
    <SolidColorBrush x:Key="AccentVioletBgBrush" Color="{StaticResource AccentVioletBgColor}"/>

</ResourceDictionary>
