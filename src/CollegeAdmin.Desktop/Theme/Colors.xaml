<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- College Admin design system — one palette, used everywhere, so every screen looks like
         part of the same product instead of a pile of default WPF controls. Modern "SaaS admin
         console" look: indigo primary, slate neutrals, a dark sidebar for wayfinding. -->

    <Color x:Key="PrimaryColor">#4F46E5</Color>
    <Color x:Key="PrimaryDarkColor">#4338CA</Color>
    <Color x:Key="PrimaryLightColor">#EEF2FF</Color>

    <Color x:Key="SidebarBgColor">#111827</Color>
    <Color x:Key="SidebarHoverColor">#1F2937</Color>
    <Color x:Key="SidebarSelectedColor">#374151</Color>
    <Color x:Key="SidebarTextColor">#D1D5DB</Color>
    <Color x:Key="SidebarTextMutedColor">#9CA3AF</Color>

    <Color x:Key="PageBgColor">#F8FAFC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>

    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>

    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessBgColor">#F0FDF4</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerDarkColor">#B91C1C</Color>
    <Color x:Key="DangerBgColor">#FEF2F2</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningBgColor">#FFFBEB</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>

    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="{StaticResource SidebarTextMutedColor}"/>

    <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource PageBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDarkColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>

</ResourceDictionary>
